---
import Base from "../layouts/baseLayout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES } from "../content.config";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const base = import.meta.env.BASE_URL;
---

<Base pageTitle="Team blog">
    <h1 class="page-title">Progress</h1>

    <div class="filters" role="group" aria-label="Filter by category">
        <button class="btn" type="button" data-filter="ALL" aria-pressed="true">All</button>
        {CATEGORIES.map((c) => <button class="btn btn--ghost" type="button" data-filter={c} aria-pressed="false">{c}</button>)}
    </div>

    <ul class="posts">
        {posts.map((post) => (
            <li class="post" data-category={post.data.category}>
                <a href={`${base}blog/${post.id}`}>
                    <span class="post_meta">
                        {post.data.category} · {post.data.author} · {post.data.date.toLocaleDateString("en-GB")}
                    </span>
                    <h2 class="post_title">{post.data.title}</h2>
                    <p>{post.data.description}</p>
                </a>
            </li>
        ))}
    </ul>
    <p class="empty hidden" id="empty">No posts in this category yet.</p>
</Base>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const posts = document.querySelectorAll<HTMLElement>(".post");
    const empty = document.querySelector("#empty")!;

    buttons.forEach((button) =>
        button.addEventListener("click", () => {
            const filter = button.dataset.filter;
            let visible = 0;
            posts.forEach((post) => {
                const show = filter === "ALL" || post.dataset.category === filter;
                post.classList.toggle("hidden", !show);
                if (show) visible++;
            });
            buttons.forEach((b) => {
                const active = b === button;
                b.setAttribute("aria-pressed", String(active));
                b.classList.toggle("btn--ghost", !active);
            });
            empty.classList.toggle("hidden", visible > 0);
        }),
    );
</script>

<style>
    .filters {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-0-50);
        margin-bottom: var(--space-2);
    }

    .posts {
        display: grid;
        gap: var(--space-1);
        list-style: none;
        padding: 0;
    }

    .post a {
        display: block;
        padding: var(--space-1);
        border: 2px solid var(--color-white);
        border-radius: var(--radius-md);
        text-decoration: none;
        transition: background-color 0.15s, color 0.15s;
    }

    .post a:hover,
    .post a:focus-visible {
        background-color: var(--color-white);
        color: var(--color-black);
    }

    .post_meta {
        font-size: var(--font-size-sm);
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .post_title {
        font-size: var(--font-size-xl);
        margin-block: 0.25rem;
    }
</style>
