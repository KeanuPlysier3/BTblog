---
import Base from "../layouts/baseLayout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES } from "../content.config";
import TimeTracker from "../components/TimeTracker.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const base = import.meta.env.BASE_URL;
---

<Base pageTitle="Team blog">
    <h1 class="page-title">Progress</h1>

    <div class="tabs" role="tablist" aria-label="Filter by category">
        <button class="tab" type="button" role="tab" data-filter="ALL" aria-selected="true">All</button>
        {CATEGORIES.map((c) => <button class="tab" type="button" role="tab" data-filter={c} aria-selected="false">{c}</button>)}
        <button class="tab" type="button" role="tab" data-filter="TIME" aria-selected="false">TIME</button>
    </div>

    <TimeTracker />

    <ul class="posts">
        {posts.map((post) => (
            <li class="post" data-category={post.data.category}>
                <a href={`${base}blog/${post.id}`}>
                    <span class="post_meta">
                        {post.data.category} · {post.data.author} · {post.data.date.toLocaleDateString("en-GB")}
                    </span>
                    <h2 class="post_title">{post.data.title}</h2>
                    <p>{post.data.description}</p>
                </a>
            </li>
        ))}
    </ul>
    <p class="empty hidden" id="empty">No posts in this category yet.</p>
</Base>

<script>
    const tabs = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const posts = document.querySelectorAll<HTMLElement>(".post");
    const list = document.querySelector<HTMLElement>(".posts")!;
    const empty = document.querySelector("#empty")!;
    const timePanel = document.querySelector("#time-panel")!;

    function select(filter: string) {
        const isTime = filter === "TIME";
        let visible = 0;
        posts.forEach((post) => {
            const show = filter === "ALL" || post.dataset.category === filter;
            post.classList.toggle("hidden", !show);
            if (show) visible++;
        });
        tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.filter === filter)));
        list.classList.toggle("hidden", isTime);
        timePanel.classList.toggle("hidden", !isTime);
        empty.classList.toggle("hidden", isTime || visible > 0);
        // Lets the TIME tab be bookmarked or linked as /#time
        history.replaceState(null, "", isTime ? "#time" : location.pathname + location.search);
    }

    tabs.forEach((tab) => tab.addEventListener("click", () => select(tab.dataset.filter!)));
    if (location.hash === "#time") select("TIME");
</script>

<style>
    .tabs {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-0-50) var(--space-1);
        margin-bottom: var(--space-2);
        border-bottom: 2px solid var(--color-line);
    }

    .tab {
        font: inherit;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--color-grey);
        background: none;
        border: 0;
        border-bottom: 4px solid transparent;
        margin-bottom: -2px;
        padding: var(--space-0-50) var(--space-0-50);
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s;
    }

    .tab:hover {
        color: var(--color-white);
    }

    .tab[aria-selected="true"] {
        color: var(--color-white);
        border-bottom-color: var(--color-white);
    }

    .posts {
        display: grid;
        gap: var(--space-1);
        list-style: none;
        padding: 0;
    }

    .post a {
        display: block;
        padding: var(--space-1);
        border: 2px solid var(--color-white);
        border-radius: var(--radius-md);
        text-decoration: none;
        transition: background-color 0.15s, color 0.15s;
    }

    .post a:hover,
    .post a:focus-visible {
        background-color: var(--color-white);
        color: var(--color-black);
    }

    .post_meta {
        font-size: var(--font-size-sm);
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .post_title {
        font-size: var(--font-size-xl);
        margin-block: 0.25rem;
    }
</style>
