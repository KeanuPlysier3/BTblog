---
import Base from "../layouts/baseLayout.astro";
import { CATEGORIES } from "../content.config";

const repo = import.meta.env.PUBLIC_GITHUB_REPO ?? "";
const branch = import.meta.env.PUBLIC_GITHUB_BRANCH ?? "main";
---

<Base pageTitle="New post">
    <h1 class="page-title">New post</h1>

    <form id="post-form" data-repo={repo} data-branch={branch}>
        <div class="field">
            <label for="title">Title</label>
            <input id="title" name="title" placeholder="e.g. User interview findings" required />
        </div>
        <div class="field">
            <label for="description">Short description</label>
            <input id="description" name="description" placeholder="One line shown on the feed" required />
        </div>
        <div class="field">
            <label for="category">Category</label>
            <select id="category" name="category">
                {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
            </select>
        </div>
        <div class="field">
            <div class="field_head">
                <label for="body">Post (markdown)</label>
                <button class="btn btn--ghost btn--small" type="button" id="ai-template">Insert AI template</button>
            </div>
            <textarea id="body" name="body" placeholder="Write in markdown…" required></textarea>
        </div>
        <div class="field">
            <label for="images">Images (inserted into the post at the cursor)</label>
            <input id="images" type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple />
        </div>
        <div class="field">
            <label for="token">GitHub token</label>
            <input id="token" name="token" type="password" autocomplete="off" required />
        </div>
        <p class="hint">Needs "Contents: read and write" on this repo. Saved in this browser only.</p>
        <div class="form-actions">
            <button class="btn" type="submit">Publish</button>
        </div>
        <p class="message" id="message" role="status" hidden></p>
    </form>
</Base>

<script>
    import { getSession } from "../lib/session";
    import { slugify, toBase64, blobToBase64, shrinkImage } from "../lib/utils";
    import { AI_TEMPLATE } from "../lib/templates";

    const form = document.querySelector<HTMLFormElement>("#post-form")!;
    const message = document.querySelector<HTMLElement>("#message")!;
    const tokenInput = form.elements.namedItem("token") as HTMLInputElement;
    const session = getSession();

    // Teachers are read-only: bounce them back to the feed.
    if (session && session.role !== "member") {
        location.replace(document.body.dataset.base ?? "/");
    }

    tokenInput.value = localStorage.getItem("blog-github-token") ?? "";

    function show(text: string, error = false) {
        message.textContent = text;
        message.dataset.error = String(error);
        message.hidden = false;
    }

    // Inserts the AI template without overwriting anything already written.
    const body = form.elements.namedItem("body") as HTMLTextAreaElement;
    document.querySelector("#ai-template")!.addEventListener("click", () => {
        body.value = body.value.trim() ? `${body.value.trimEnd()}\n\n${AI_TEMPLATE}` : AI_TEMPLATE;
        body.focus();
    });

    // Images picked in this session, keyed by their final file name. Uploaded on Publish.
    const pendingImages = new Map<string, Blob>();
    const imageInput = document.querySelector<HTMLInputElement>("#images")!;

    imageInput.addEventListener("change", async () => {
        for (const file of imageInput.files ?? []) {
            try {
                const blob = await shrinkImage(file);
                const ext = blob.type.split("/")[1] || "png";
                const stamp = new Date().toISOString().replace(/\D/g, "").slice(0, 14);
                const base = slugify(file.name.replace(/\.[^.]+$/, "")) || "image";
                const name = `${stamp}-${base}.${ext}`;
                pendingImages.set(name, blob);
                // Relative path from src/content/blog so Astro optimises it and handles the site base.
                const link = `![${base.replace(/-/g, " ")}](../../assets/blog/${name})`;
                const at = body.selectionStart ?? body.value.length;
                body.setRangeText(`\n${link}\n`, at, body.selectionEnd ?? at, "end");
            } catch {
                show(`Could not read ${file.name}.`, true);
            }
        }
        imageInput.value = "";
    });

    form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!session || session.role !== "member") return;
        const repo = form.dataset.repo;
        if (!repo) return show("PUBLIC_GITHUB_REPO is not configured for this build.", true);

        const data = new FormData(form);
        const title = String(data.get("title")).trim();
        const date = new Date().toISOString();
        const slug = `${date.slice(0, 10)}-${slugify(title) || "post"}`;
        const markdown = [
            "---",
            `title: ${JSON.stringify(title)}`,
            `description: ${JSON.stringify(String(data.get("description")).trim())}`,
            `category: ${data.get("category")}`,
            `author: ${session.name}`,
            `date: ${date}`,
            "---",
            "",
            String(data.get("body")).trim(),
            "",
        ].join("\n");

        const token = String(data.get("token")).trim();
        const headers = { Authorization: `Bearer ${token}`, Accept: "application/vnd.github+json" };
        const postBody = String(data.get("body"));

        // Upload images first so a failed upload never leaves a post with broken images.
        // Only images still referenced in the text are sent.
        for (const [name, blob] of pendingImages) {
            if (!postBody.includes(name)) continue;
            show(`Uploading ${name}…`);
            const upload = await fetch(`https://api.github.com/repos/${repo}/contents/src/assets/blog/${name}`, {
                method: "PUT",
                headers,
                body: JSON.stringify({
                    message: `blog: image ${name} (${session.name})`,
                    content: await blobToBase64(blob),
                    branch: form.dataset.branch,
                }),
            });
            // 422 means the image is already in the repo (e.g. from a retry), which is fine.
            if (!upload.ok && upload.status !== 422) {
                const detail = (await upload.json().catch(() => ({}))).message ?? upload.statusText;
                return show(`Image upload failed (${upload.status}): ${detail}`, true);
            }
        }

        show("Publishing…");
        const response = await fetch(`https://api.github.com/repos/${repo}/contents/src/content/blog/${slug}.md`, {
            method: "PUT",
            headers,
            body: JSON.stringify({
                message: `blog: ${title} (${session.name})`,
                content: toBase64(markdown),
                branch: form.dataset.branch,
            }),
        });

        if (response.ok) {
            localStorage.setItem("blog-github-token", token);
            show("Published! GitHub Pages is rebuilding — your post shows up on the feed in about a minute.");
            form.reset();
            pendingImages.clear();
            tokenInput.value = token;
        } else if (response.status === 422) {
            show("A post with that title already exists today. Change the title and try again.", true);
        } else {
            const detail = (await response.json().catch(() => ({}))).message ?? response.statusText;
            show(`GitHub rejected the post (${response.status}): ${detail}`, true);
        }
    });
</script>
